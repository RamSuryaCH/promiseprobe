{
  "name": "promiseprobe",
  "version": "1.0.0",
  "description": "A test harness that catches web apps claiming success before work is safely persisted.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "promiseprobe": "./bin/promiseprobe.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "playwright install chromium && npm run typecheck && vitest run",
    "demo": "tsx scripts/demo.ts",
    "metrics": "tsx scripts/metrics.ts",
    "promiseprobe": "tsx src/cli.ts"
  },
  "dependencies": {
    "playwright": "^1.49.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
